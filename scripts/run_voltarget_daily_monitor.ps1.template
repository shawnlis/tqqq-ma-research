param()

Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"

$RepoRoot = Resolve-Path (Join-Path $PSScriptRoot "..")
$LogDir = Join-Path $RepoRoot "logs\voltarget_monitor"
$SignalDir = Join-Path $RepoRoot "outputs\live_signal"
$StatusPath = Join-Path $SignalDir "latest_automation_status.json"
$LedgerPath = Join-Path $RepoRoot "data\paper_trading\voltarget_paper_trades.csv"

New-Item -ItemType Directory -Force -Path $LogDir | Out-Null
New-Item -ItemType Directory -Force -Path $SignalDir | Out-Null

$Timestamp = Get-Date -Format "yyyyMMdd_HHmmss"
$LogPath = Join-Path $LogDir "voltarget_daily_$Timestamp.log"
$Steps = New-Object System.Collections.Generic.List[object]
$HardFailure = $false

function Write-Log {
    param([string]$Message)
    $Line = "$(Get-Date -Format o) $Message"
    Add-Content -LiteralPath $LogPath -Value $Line
    Write-Host $Line
}

function Add-Step {
    param([string]$Name, [string]$Status, [string]$Detail)
    $Steps.Add([ordered]@{
        name = $Name
        status = $Status
        detail = $Detail
    }) | Out-Null
}

function Write-Status {
    param([string]$Status, [string]$Message)
    $Payload = [ordered]@{
        generated_at = (Get-Date).ToUniversalTime().ToString("o")
        status = $Status
        message = $Message
        log_file = $LogPath
        paper_trading_only = $true
        no_auto_trading = $true
        no_broker_integration = $true
        steps = $Steps
    }
    $Payload | ConvertTo-Json -Depth 6 | Set-Content -LiteralPath $StatusPath -Encoding UTF8
}

function Invoke-MonitorStep {
    param(
        [string]$Name,
        [string[]]$Arguments,
        [bool]$Required = $true
    )
    Write-Log "START $Name"
    if ($env:VOLTARGET_MONITOR_SIMULATE -eq "1") {
        Add-Step -Name $Name -Status "simulated" -Detail ("python " + ($Arguments -join " "))
        Write-Log "SIMULATED $Name"
        return
    }
    & python @Arguments 2>&1 | Tee-Object -FilePath $LogPath -Append
    $ExitCode = $LASTEXITCODE
    if ($ExitCode -ne 0) {
        Add-Step -Name $Name -Status "failed" -Detail "exit_code=$ExitCode"
        Write-Log "FAILED $Name exit_code=$ExitCode"
        if ($Required) {
            throw "$Name failed with exit code $ExitCode"
        }
    } else {
        Add-Step -Name $Name -Status "ok" -Detail "exit_code=0"
        Write-Log "OK $Name"
    }
}

try {
    Set-Location -LiteralPath $RepoRoot
    Write-Log "PAPER MONITORING ONLY. NO AUTO-TRADING. NO BROKER API CALLS."
    Write-Log "RepoRoot=$RepoRoot"

    Invoke-MonitorStep -Name "daily_monitor" -Arguments @(
        "-m", "research.cli", "run-daily-voltarget-monitor",
        "--config", "configs\voltarget_live_monitor.yaml"
    ) -Required $true

    Invoke-MonitorStep -Name "execution_drift" -Arguments @(
        "-m", "research.cli", "track-execution-drift",
        "--config", "configs\voltarget_live_monitor.yaml",
        "--signal-dir", "outputs\live_signal",
        "--output-dir", "outputs\execution_drift"
    ) -Required $true

    Write-Log "Financing update is part of run-daily-voltarget-monitor/generate-voltarget-signal."
    Add-Step -Name "financing_update" -Status "included" -Detail "financing_cost_history.csv and financing_cost_report.md are written by the daily monitor"

    if (Test-Path -LiteralPath $LedgerPath) {
        Invoke-MonitorStep -Name "paper_trade_reconciliation" -Arguments @(
            "-m", "research.cli", "reconcile-paper-trades",
            "--signal-dir", "outputs\live_signal",
            "--ledger", "data\paper_trading\voltarget_paper_trades.csv",
            "--output-dir", "outputs\paper_reconciliation"
        ) -Required $true
    } else {
        Write-Log "WARNING ledger missing: $LedgerPath. Reconciliation skipped without hard failure."
        Add-Step -Name "paper_trade_reconciliation" -Status "warning" -Detail "ledger missing; skipped"
    }

    Write-Status -Status "ok" -Message "Daily VolTarget paper monitor completed."
    exit 0
} catch {
    $HardFailure = $true
    Write-Log "HARD FAILURE $($_.Exception.Message)"
    Write-Status -Status "failed" -Message $_.Exception.Message
    exit 1
}
